{
  "name": "mind-forge",
  "version": "2.0.0",
  "description": "面向真实复杂场景的 Vue 精品能力实验室",
  "type": "module",
  "main": "dist/mind-forge.cjs",
  "module": "dist/mind-forge.es.js",
  "types": "dist/packages/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/index.d.ts",
      "import": "./dist/mind-forge.es.js",
      "require": "./dist/mind-forge.cjs"
    },
    "./feedback": {
      "types": "./dist/packages/feedback/index.d.ts",
      "import": "./dist/mind-forge.es.js",
      "require": "./dist/mind-forge.cjs"
    },
    "./typewriter": {
      "types": "./dist/packages/typewriter/index.d.ts",
      "import": "./dist/mind-forge.es.js",
      "require": "./dist/mind-forge.cjs"
    },
    "./prompt-suggestions": {
      "types": "./dist/packages/prompt-suggestions/index.d.ts",
      "import": "./dist/mind-forge.es.js",
      "require": "./dist/mind-forge.cjs"
    },
    "./tooltip": {
      "types": "./dist/packages/tooltip/index.d.ts",
      "import": "./dist/mind-forge.es.js",
      "require": "./dist/mind-forge.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.vue",
    "*.css",
    "*.scss",
    "packages/**/*.vue",
    "packages/**/*.scss",
    "apps/playground/src/assets/styles/**/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:lib": "vue-tsc -p tsconfig.lib.json && vite build --mode lib",
    "docs:dev": "vitepress dev apps/docs",
    "docs:build": "vitepress build apps/docs",
    "docs:preview": "vitepress preview apps/docs",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .vue,.js,.ts,.tsx,.jsx --fix",
    "format": "prettier --write .",
    "stylelint": "stylelint \"**/*.{vue,css,scss}\" --fix"
  },
  "peerDependencies": {
    "vue": "^3.3.11"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vitest/coverage-v8": "^1.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-vue": "^9.19.2",
    "husky": "^8.0.3",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "sass": "^1.69.5",
    "stylelint": "^16.0.2",
    "stylelint-config-standard-scss": "^12.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^3.6.4",
    "vitepress": "^1.0.0-rc.30",
    "vitest": "^1.1.0",
    "vue": "^3.3.11",
    "vue-tsc": "^2.2.12"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,vue}": [
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "*.{vue,css,scss}": [
      "stylelint --fix"
    ]
  },
  "keywords": [
    "vue3",
    "typescript",
    "vite",
    "components",
    "utils",
    "hooks"
  ],
  "author": "ajl",
  "license": "MIT",
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  }
}
